{
  "name": "@rootfold/brief-once",
  "version": "0.1.3",
  "description": "Cross-agent development continuity for AI coding tools.",
  "type": "module",
  "bin": {
    "b1": "./dist/cli.js",
    "briefonce": "./dist/cli.js",
    "brief-once": "./dist/cli.js",
    "agentfold": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "scripts": {
    "b1": "tsx src/cli/index.ts",
    "briefonce": "tsx src/cli/index.ts",
    "agentfold": "tsx src/cli/index.ts",
    "dev": "tsx src/cli/index.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.5",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "briefonce",
    "ai",
    "coding-agent",
    "coding-agents",
    "mcp",
    "codex",
    "antigravity",
    "developer-tools",
    "agent-handoff",
    "context-continuity",
    "local-first"
  ],
  "author": "RootFold",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rootfold/brief-once.git"
  },
  "homepage": "https://github.com/rootfold/brief-once#readme",
  "bugs": {
    "url": "https://github.com/rootfold/brief-once/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "commander": "^14.0.2",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.7.0",
    "yaml": "^2.9.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.19.25",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.15"
  }
}
